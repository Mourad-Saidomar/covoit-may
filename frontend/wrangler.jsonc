{
  // Mise en ligne du front-end sur Cloudflare Workers (fichiers statiques).
  // Le nom doit être celui du Worker créé dans le tableau de bord Cloudflare.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "covoit-may",
  "compatibility_date": "2026-08-25",
  "assets": {
    // Site compilé par « npm run build »
    "directory": "./dist",
    // Application monopage : toute adresse inconnue (/recherche, /trajets/12…)
    // renvoie index.html, et Vue Router affiche la bonne page.
    "not_found_handling": "single-page-application"
  }
}
