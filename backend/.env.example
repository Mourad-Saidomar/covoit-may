# ============================================================
# Configuration du backend Covoit'May
# Copiez ce fichier en ".env" puis remplissez les valeurs.
# Le fichier .env n'est JAMAIS envoyé sur Git (voir .gitignore).
# ============================================================

# Port de l'API
PORT=3000

# Adresse du frontend autorisée à appeler l'API (CORS)
FRONTEND_URL=http://localhost:5173

# Base MariaDB : le compte créé à la fin de database/covoitmay.sql
# (droits minimaux, jamais root)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=covoitmay
DB_USER=covoitmay_app
DB_PASSWORD=Covoit-May_App_2026!

# Clé secrète qui signe les jetons de connexion : 32 caractères minimum.
# Pour en générer une :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=remplacez-moi-par-une-longue-cle-aleatoire-de-64-caracteres
JWT_DUREE=2h

# Limites par adresse IP et par quart d'heure (RG13.6)
LIMITE_REQUETES=300
LIMITE_CONNEXIONS=10

# Production uniquement, derrière un proxy (alwaysdata, Nginx) : 1.
# À laisser vide en local.
TRUST_PROXY=

# Stockage des médias (photos de profil, photos et vocaux de la messagerie)
# sur Backblaze B2, dans un bucket PRIVÉ. Laisser vide en local : les
# fichiers vont alors dans backend/uploads/medias.
# B2_S3_ENDPOINT : l'« Endpoint » du bucket, précédé de https://
B2_S3_ENDPOINT=
B2_BUCKET_MEDIAS=
B2_KEY_ID=
B2_APPLICATION_KEY=

# Envoi des emails (codes de vérification à l'inscription et pour le
# mot de passe oublié). Laisser SMTP_HOST vide en local : le code est
# alors affiché dans la console du serveur.
# Port 587 (STARTTLS) ou 465 (SSL). Tester : npm run test:email -- vous@exemple.fr
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Covoit'May <no-reply@exemple.fr>
